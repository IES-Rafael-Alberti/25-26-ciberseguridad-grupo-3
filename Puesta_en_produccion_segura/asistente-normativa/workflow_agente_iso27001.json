{
  "id": "workflow_agente_iso27001",
  "name": "Agente ISO27001",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "pregunta"
            },
            {
              "name": "objetivo"
            }
          ]
        }
      },
      "id": "7a58fd2a-9a7e-4a91-89e9-d7776b6cc50e",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-520, 60]
    },
    {
      "parameters": {
        "text": "=Pregunta: {{ $json.pregunta }}\n\nObjetivo: {{ $json.objetivo || 'Responde con detalle citando secciones concretas.' }}",
        "promptType": "define",
        "options": {
          "systemMessage": "Eres un experto en ISO/IEC 27001:2022. Respondes unicamente sobre esta normativa. Cuando cites informacion, indica el control o seccion especifica, por ejemplo Anexo A, Control A.8.1. Usa la herramienta rag_iso27001 para recuperar evidencias antes de contestar. Si la respuesta no aparece en la normativa indexada, dilo con claridad. Si necesitas calculos, comparaciones o transformaciones de datos, usa la herramienta ejecutar_codigo."
        }
      },
      "id": "496bf747-84a0-4abf-8d4d-8647d5d92124",
      "name": "AI Agent ISO27001",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-180, 60]
    },
    {
      "parameters": {
        "model": "={{ $env.OLLAMA_CHAT_MODEL || 'qwen3:8b' }}",
        "options": {
          "temperature": 0.2,
          "numCtx": 8192
        }
      },
      "id": "1eb5d7c9-b38f-44cb-a32e-52cc85d0bb11",
      "name": "Ollama qwen3",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [-320, 300],
      "credentials": {
        "ollamaApi": {
          "id": "",
          "name": "Local Ollama service"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "rag_iso27001",
        "toolDescription": "Busca fragmentos oficiales de ISO/IEC 27001:2022 en Qdrant. Devuelve texto y metadata con fuente y normativa.",
        "topK": 5,
        "includeDocumentMetadata": true,
        "options": {
          "searchFilterJson": "={\n  \"must\": [\n    {\n      \"key\": \"metadata.normativa\",\n      \"match\": { \"value\": \"ISO27001\" }\n    }\n  ]\n}"
        },
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.QDRANT_COLLECTION || 'normativa_ciberseguridad' }}"
        }
      },
      "id": "f3e1c03b-4c57-4278-86cd-9621485dc593",
      "name": "Qdrant ISO27001 Retriever",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [-80, 300],
      "credentials": {
        "qdrantApi": {
          "id": "",
          "name": "Local Qdrant service"
        }
      }
    },
    {
      "parameters": {
        "model": "={{ $env.OLLAMA_EMBED_MODEL || 'nomic-embed-text:latest' }}"
      },
      "id": "53938dc7-02e2-4ac5-b5b1-c0d0b6ffed87",
      "name": "Embeddings Ollama",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [-80, 520],
      "credentials": {
        "ollamaApi": {
          "id": "",
          "name": "Local Ollama service"
        }
      }
    },
    {
      "parameters": {
        "command": "=node -e {{ JSON.stringify($fromAI('code', 'Codigo JavaScript autocontenido. Debe imprimir el resultado por stdout.', 'string')) }}",
        "toolDescription": "Ejecuta codigo JavaScript pequeno y autocontenido dentro del contenedor n8n. Devuelve stdout/stderr."
      },
      "id": "58db75bd-4586-4f71-9b51-cf0200f57888",
      "name": "ejecutar_codigo",
      "type": "n8n-nodes-base.executeCommandTool",
      "typeVersion": 1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5ff35914-0b96-4e34-a1b0-d3527b4ca5c0",
              "name": "output",
              "type": "string",
              "value": "={{ $json.output || $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "603bb085-b0d0-4bee-9f80-2ed128597857",
      "name": "Devolver respuesta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 60]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{"node": "AI Agent ISO27001", "type": "main", "index": 0}]]
    },
    "AI Agent ISO27001": {
      "main": [[{"node": "Devolver respuesta", "type": "main", "index": 0}]]
    },
    "Ollama qwen3": {
      "ai_languageModel": [[{"node": "AI Agent ISO27001", "type": "ai_languageModel", "index": 0}]]
    },
    "Qdrant ISO27001 Retriever": {
      "ai_tool": [[{"node": "AI Agent ISO27001", "type": "ai_tool", "index": 0}]]
    },
    "Embeddings Ollama": {
      "ai_embedding": [[{"node": "Qdrant ISO27001 Retriever", "type": "ai_embedding", "index": 0}]]
    },
    "ejecutar_codigo": {
      "ai_tool": [[{"node": "AI Agent ISO27001", "type": "ai_tool", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
